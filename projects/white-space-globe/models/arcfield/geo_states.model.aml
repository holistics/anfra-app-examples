Model geo_states {
  type: 'table'
  label: 'US states'
  description: 'One row per US state plus DC (51). States are reached through Market size (cities link to their market, markets to states). States do not link to countries: the dataset allows one route only.'
  data_source_name: 'arcfield_duckdb'
  table_name: 'main.geo_states'

  dimension state_code {
    label: 'State code'
    type: 'text'
    primary_key: true
    description: 'ISO 3166-2 code, e.g. US-CA, US-TX.'
  }
  dimension country_code {
    label: 'State country code'
    type: 'text'
    description: 'Always USA. Information only: there is no relationship from states to countries.'
  }
  dimension name {
    label: 'State'
    type: 'text'
    description: 'State name, e.g. California.'
  }
  dimension lat {
    label: 'State latitude'
    type: 'number'
    description: 'Label point latitude (degrees).'
  }
  dimension lon {
    label: 'State longitude'
    type: 'number'
    description: 'Label point longitude (degrees).'
  }
}
