Model nether_book {
  type: 'table'
  label: 'Book'
  data_source_name: 'nether'
  table_name: 'book'

  dimension book_id {
    label: 'Book Id'
    type: 'text'
    primary_key: true
    definition: @sql {{ #SOURCE.book_id }} ;;
  }
  dimension title {
    label: 'Title'
    type: 'text'
    definition: @sql {{ #SOURCE.title }} ;;
  }
  dimension author {
    label: 'Author'
    type: 'text'
    definition: @sql {{ #SOURCE.author }} ;;
  }
  dimension subject {
    label: 'Subject'
    type: 'text'
    definition: @sql {{ #SOURCE.subject }} ;;
  }
}
