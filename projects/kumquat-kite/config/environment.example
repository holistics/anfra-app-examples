# Kumquat Kite POC settings. `npm run setup` copies the missing ones to .env.local (git-ignored), with generated
# passwords, and prints none of them. The app needs no Supabase setting. One KEY=value per line, comments on their own.

# PostgreSQL: the Docker Compose service on this machine by default (any PostgreSQL 17 works).
KK_DB_HOST=127.0.0.1
KK_DB_PORT=54339
KK_DB_NAME=kumquat_demo
KK_DB_DEMO_NAME=kumquat_demo
KK_DB_TEST_NAME=kumquat_test
# For a hosted PostgreSQL that requires TLS (off for the local Compose database):
# KK_DB_SSL=require

# The database owner: migrations, the seed, the command-line demo reset and backups.
KK_DB_OWNER=kumquat
KK_DB_OWNER_PASSWORD=<generated by npm run setup>
# The app server's role kk_app, to which row-level security and the triggers apply.
KK_APP_DB_PASSWORD=<generated by npm run setup>
# Anfra's SELECT-only role anfra_reader, which reads the reporting views.
ANFRA_DB_PASSWORD=<generated by npm run setup>

# Demo sessions: the server signs the chosen persona with this key.
KK_SESSION_SECRET=<generated by npm run setup>

# Optional. The Holistics workspace "Add report" opens (off removes the button):
# HOLISTICS_REPORTS_URL=https://bi.holistics.io
# Embedded viewing of Holistics dashboards stays off unless both are set:
# HOLISTICS_EMBED_KEY_ID=
# HOLISTICS_EMBED_SECRET=
