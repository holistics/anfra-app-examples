Model scenario_sweep {
  type: 'query'
  label: 'Planner: Setting sweeps'
  description: '''One row per set of settings, setting and value it can take: the race time with that one value and every other setting held, and its zone (green safe, amber caution, red injury risk; leaving race morning outside the freshness band is a caution too).

Every setting is a dimension: filter each to one value (race_id, runs_per_week, peak_km, quality, long_max_km, ramp_pct, taper_weeks, front_loaded, tune_up, start_km), or the model computes every combination of the ones left open.'''
  data_source_name: 'garmin'
  query: @sql
    select g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km,
           s.key as setting, s.ord as setting_order, s.label as setting_label, s.unit as unit, s.life as life, s.risk_note as risk_note, s.current_value as current_value, s.value as value, s.time_s as time_s, s.shape as shape, s.vo2 as vo2, s.zone as zone, s.fresh as fresh, s.reaches as reaches
    from garmin.scenario_grid g
    cross join lateral garmin.scn_scenario_sweep(g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km) s
  ;;

  dimension race_id {
    label: 'Race ID'
    type: 'number'
    description: 'Goal race (an upcoming race)'
    hidden: true
    definition: @sql {{ #SOURCE.race_id }};;
  }
  dimension runs_per_week {
    label: 'Runs per week'
    type: 'number'
    description: 'Setting: runs a week, the long run and quality sessions included (3 to 7)'
    definition: @sql {{ #SOURCE.runs_per_week }};;
  }
  dimension peak_km {
    label: 'Biggest week (km)'
    type: 'number'
    description: 'Setting: the biggest week the plan may reach (15 to 160 km)'
    definition: @sql {{ #SOURCE.peak_km }};;
  }
  dimension quality {
    label: 'Quality sessions'
    type: 'number'
    description: 'Setting: quality sessions a week (0 to 2; at most runs per week minus 1)'
    definition: @sql {{ #SOURCE.quality }};;
  }
  dimension long_max_km {
    label: 'Longest long run (km)'
    type: 'number'
    description: 'Setting: the longest long run (8 to 42 km)'
    definition: @sql {{ #SOURCE.long_max_km }};;
  }
  dimension ramp_pct {
    label: 'Weekly increase (%)'
    type: 'number'
    description: 'Setting: how much a build week may rise over the one before (0 to 30 %)'
    definition: @sql {{ #SOURCE.ramp_pct }};;
  }
  dimension taper_weeks {
    label: 'Taper (weeks)'
    type: 'number'
    description: 'Setting: taper length, race week included (1 to 3)'
    definition: @sql {{ #SOURCE.taper_weeks }};;
  }
  dimension front_loaded {
    label: 'Front-loaded'
    type: 'number'
    description: 'Setting: build-up, 0 gradual (biggest week at the peak), 1 front-loaded (biggest week as early as the weekly increase allows)'
    definition: @sql {{ #SOURCE.front_loaded }};;
  }
  dimension tune_up {
    label: 'Tune-up race'
    type: 'number'
    description: 'Setting: 1 for a tune-up race 6 weeks before race week (half marathon or longer, 12+ weeks to go)'
    definition: @sql {{ #SOURCE.tune_up }};;
  }
  dimension start_km {
    label: 'This week (km)'
    type: 'number'
    description: 'Setting: this week’s km, the plan’s starting load (10 to 160, in steps of 0.1)'
    definition: @sql {{ #SOURCE.start_km }};;
  }
  dimension setting {
    label: 'Setting'
    type: 'text'
    description: 'Setting: one point of a setting sweep'
    definition: @sql {{ #SOURCE.setting }};;
  }
  dimension setting_order {
    label: 'Setting order'
    type: 'number'
    description: 'Setting order: one point of a setting sweep'
    definition: @sql {{ #SOURCE.setting_order }};;
  }
  dimension setting_label {
    label: 'Setting label'
    type: 'text'
    description: 'Setting label: one point of a setting sweep'
    definition: @sql {{ #SOURCE.setting_label }};;
  }
  dimension unit {
    label: 'Unit'
    type: 'text'
    description: 'Unit: one point of a setting sweep'
    definition: @sql {{ #SOURCE.unit }};;
  }
  dimension life {
    label: 'Life constraint'
    type: 'truefalse'
    description: 'Life constraint: one point of a setting sweep'
    definition: @sql {{ #SOURCE.life }};;
  }
  dimension risk_note {
    label: 'Risk note'
    type: 'text'
    description: 'Risk note: one point of a setting sweep'
    definition: @sql {{ #SOURCE.risk_note }};;
  }
  dimension current_value {
    label: 'Current value'
    type: 'number'
    description: 'Current value: one point of a setting sweep'
    definition: @sql {{ #SOURCE.current_value }};;
  }
  dimension value {
    label: 'Value'
    type: 'number'
    description: 'Value: one point of a setting sweep'
    definition: @sql {{ #SOURCE.value }};;
  }
  dimension time_s {
    label: 'Race time at this value (s)'
    type: 'number'
    description: 'Race time at this value (s): one point of a setting sweep'
    definition: @sql {{ #SOURCE.time_s }};;
  }
  dimension shape {
    label: 'Marathon shape at this value (%)'
    type: 'number'
    description: 'Marathon shape at this value (%): one point of a setting sweep'
    definition: @sql {{ #SOURCE.shape }};;
  }
  dimension vo2 {
    label: 'Race fitness at this value'
    type: 'number'
    description: 'Race fitness at this value: one point of a setting sweep'
    definition: @sql {{ #SOURCE.vo2 }};;
  }
  dimension zone {
    label: 'Zone'
    type: 'text'
    description: 'Zone: one point of a setting sweep'
    definition: @sql {{ #SOURCE.zone }};;
  }
  dimension fresh {
    label: 'Race morning fresh'
    type: 'truefalse'
    description: 'Race morning fresh: one point of a setting sweep'
    definition: @sql {{ #SOURCE.fresh }};;
  }
  dimension reaches {
    label: 'Reaches the target'
    type: 'truefalse'
    description: 'Reaches the target: one point of a setting sweep'
    definition: @sql {{ #SOURCE.reaches }};;
  }
}
