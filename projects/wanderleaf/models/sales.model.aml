Model sales {
  type: 'table'
  label: 'Sales'
  description: 'One row per book sold.'
  data_source_name: 'wanderleaf'
  table_name: 'sales'

  dimension sale_id {
    label: 'Sale Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.sale_id }};;
  }
  dimension sold_at {
    label: 'Sold At'
    type: 'datetime'
    definition: @sql {{ #SOURCE.sold_at }};;
  }
  dimension day_id {
    label: 'Spot Day Id'
    type: 'text'
    hidden: true
    definition: @sql strftime(CAST({{ #SOURCE.sold_at }} AS DATE), '%Y-%m-%d') || '-' || {{ #SOURCE.spot_id }};;
  }
  dimension book_id {
    label: 'Book Id'
    type: 'number'
    hidden: true
    definition: @sql {{ #SOURCE.book_id }};;
  }
  dimension units {
    label: 'Units'
    type: 'number'
    definition: @sql {{ #SOURCE.units }};;
  }
  dimension net_revenue {
    label: 'Net Revenue'
    type: 'number'
    definition: @sql {{ #SOURCE.net_revenue }};;
  }
}
