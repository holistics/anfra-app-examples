Model nether_library_card {
  type: 'table'
  label: 'Library Card'
  data_source_name: 'nether'
  table_name: 'library_card'

  dimension card_id {
    label: 'Card Id'
    type: 'text'
    primary_key: true
    definition: @sql {{ #SOURCE.card_id }} ;;
  }
  dimension person_id {
    label: 'Person Id'
    type: 'text'
    definition: @sql {{ #SOURCE.person_id }} ;;
  }
  dimension library_id {
    label: 'Library Id'
    type: 'text'
    definition: @sql {{ #SOURCE.library_id }} ;;
  }
  dimension issued_on {
    label: 'Issued On'
    type: 'date'
    definition: @sql {{ #SOURCE.issued_on }} ;;
  }
  dimension revoked_on {
    label: 'Revoked On'
    type: 'date'
    definition: @sql {{ #SOURCE.revoked_on }} ;;
  }
}
