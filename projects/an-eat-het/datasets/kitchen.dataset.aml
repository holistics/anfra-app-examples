Dataset kitchen {
  label: 'Zero-Waste Kitchen'
  description: '''
# What this dataset is for

Menu performance, food waste and seasonality for a zero-waste fine-dining restaurant with a set tasting menu of 12 to 13 courses that changes each season: which courses earn their
place, where in the kitchen's chain the waste happens (prep, cooking, plate, spoilage), and which dishes
lean on ingredients that are out of season.

## What it cannot answer

- Real kitchen economics. Menu prices, plate costs and waste are plausible, not measured.
- Staff time, energy, or anything outside ingredients.
- Waste cost counts what was thrown away at what the ingredient cost that month. Plate waste is
  food already served, so it is also inside the plate cost: margin counts it twice, on purpose, as a penalty.

## Data provenance

**Synthetic**, generated by `scripts/generate_kitchen_data.py`. The fruit seasonal calendar is a
hand-compiled summary of Vietnam's fruit seasons (sources still to be cited); the vegetable calendar is
synthetic.
'''
  data_source_name: 'kitchen'

  models: [kitchen_dish_day, kitchen_dishes, kitchen_concepts, kitchen_menus, kitchen_dish_ingredients, kitchen_service_day, kitchen_pairings, kitchen_pairing_day, kitchen_drink_orders, kitchen_drink_waste, kitchen_ingredients, kitchen_suppliers, kitchen_waste_flow, kitchen_reuse_links]

  relationships: [
    relationship(kitchen_dish_day.dish_id > kitchen_dishes.dish_id, true),
    relationship(kitchen_dish_day.date > kitchen_service_day.date, true),
    relationship(kitchen_dishes.concept_id > kitchen_concepts.concept_id, true),
    relationship(kitchen_dishes.menu_id > kitchen_menus.menu_id, true),
    relationship(kitchen_dish_ingredients.dish_id > kitchen_dishes.dish_id, true),
    relationship(kitchen_pairing_day.date > kitchen_service_day.date, true),
    relationship(kitchen_drink_orders.date > kitchen_service_day.date, true),
    relationship(kitchen_drink_waste.date > kitchen_service_day.date, true),
    relationship(kitchen_pairing_day.pairing_id > kitchen_pairings.pairing_id, true),
    relationship(kitchen_waste_flow.dish_id > kitchen_dishes.dish_id, true),
    relationship(kitchen_waste_flow.ingredient_id > kitchen_ingredients.ingredient_id, true),
    relationship(kitchen_ingredients.supplier_id > kitchen_suppliers.supplier_id, true),
    relationship(kitchen_reuse_links.source_dish_id > kitchen_dishes.dish_id, true),
  ]

  metric units_sold {
    label: 'Plates Sold'
    type: 'number'
    definition: @aql kitchen_dish_day.qty_sold ;;
    format: '#,##0'
  }

  metric revenue {
    label: 'Revenue (USD)'
    type: 'number'
    definition: @aql kitchen_dish_day.revenue_amount ;;
    format: '#,##0'
  }

  metric ingredient_cost {
    label: 'Ingredient Cost (USD)'
    type: 'number'
    definition: @aql kitchen_dish_day.ingredient_cost_amount ;;
    format: '#,##0'
  }

  metric waste_cost {
    label: 'Waste Cost (USD)'
    type: 'number'
    definition: @aql kitchen_dish_day.prep_cost + kitchen_dish_day.cooking_cost + kitchen_dish_day.plate_cost + kitchen_dish_day.spoilage_cost ;;
    format: '#,##0'
    description: 'Prep, cooking, plate and spoilage waste, each weighed and priced at the ingredient cost of that month.'
  }

  metric dish_margin {
    label: 'Dish Margin (USD)'
    type: 'number'
    definition: @aql revenue - ingredient_cost - waste_cost ;;
    format: '#,##0'
  }

  metric margin_pct {
    label: 'Margin (%)'
    type: 'number'
    definition: @aql safe_divide(dish_margin, revenue) * 100 ;;
    format: '#,##0.0'
  }

  metric waste_rate {
    label: 'Waste Rate (%)'
    type: 'number'
    definition: @aql safe_divide(waste_cost, revenue + waste_cost) * 100 ;;
    format: '#,##0.0'
    description: 'Waste cost as a share of revenue plus waste cost.'
  }

  metric seasonality_score {
    label: 'Seasonality (%)'
    type: 'number'
    definition: @aql safe_divide(kitchen_dish_day.seasonal_plates, units_sold) * 100 ;;
    format: '#,##0'
    description: 'Share of ingredients in season, over the plates sold: in season counts 1, shoulder 0.5, out of season 0.'
  }

  metric service_days {
    label: 'Service Days'
    type: 'number'
    definition: @aql count_distinct(kitchen_dish_day.date) ;;
    format: '#,##0'
  }

  metric guest_rating {
    label: 'Guest Rating (out of 5)'
    type: 'number'
    definition: @aql safe_divide(kitchen_dish_day.rating_total_amount, kitchen_dish_day.rating_count_amount) ;;
    format: '0.00'
    description: 'What guests rated the course, out of 5.'
  }

  metric landfill_waste_rate {
    label: 'Landfill Waste Rate (%)'
    type: 'number'
    definition: @aql safe_divide(landfill_cost, revenue + waste_cost) * 100 ;;
    format: '#,##0.00'
    description: 'Cost of the waste that was thrown away, as a share of revenue plus waste cost. Like the waste rate, but reused, composted and fed waste does not count.'
  }

  metric sustainability_risk {
    label: 'Sustainability Risk (0-100)'
    type: 'number'
    definition: @aql 50 * case(when: landfill_waste_rate > 3, then: 1, else: landfill_waste_rate / 3) + 50 * (1 - seasonality_score / 100) ;;
    format: '#,##0'
    description: 'Half how much it throws away (full marks at a 3% landfill waste rate; reused, composted and fed waste does not count), half the share of its ingredients that are not in season. Higher is worse.'
  }

  metric menu_health_score {
    label: 'Menu Health (0-100)'
    type: 'number'
    definition: @aql 40 * case(when: margin_pct > 65, then: 1, else: margin_pct / 65) + 30 * case(when: guest_rating < 3.5, then: 0, else: case(when: guest_rating > 4.5, then: 1, else: guest_rating - 3.5)) + 30 * (1 - case(when: waste_rate > 15, then: 1, else: waste_rate / 15)) ;;
    format: '#,##0'
    description: '40% margin (full marks at 65%), 30% guest rating (nothing at 3.5, full marks at 4.5 out of 5), 30% low waste (nothing at a 15% waste rate). Higher is better.'
  }

  metric menu_health_avg {
    label: 'Average Menu Health (0-100)'
    type: 'number'
    definition: @aql unique(kitchen_concepts.concept_name, kitchen_dishes.category) | select(health: menu_health_score) | avg(health) ;;
    format: '#,##0.0'
    description: 'Average of the menu health score over the courses in view (a course is a concept and category), each course scored on its own first. Higher is better.'
  }

  metric courses_at_risk {
    label: 'Courses at Risk'
    type: 'number'
    definition: @aql unique(kitchen_concepts.concept_name, kitchen_dishes.category) | select(risk: sustainability_risk) | filter(risk >= 35) | count(risk) ;;
    format: '#,##0'
    description: 'Number of courses (a concept and category) in view whose sustainability risk is 35 or more.'
  }

  metric courses_on_menu {
    label: 'Courses'
    type: 'number'
    definition: @aql unique(kitchen_concepts.concept_name, kitchen_dishes.category) | select(course: units_sold) | count(course) ;;
    format: '#,##0'
    description: 'Number of courses (a concept and category) with sales in view.'
  }

  metric covers {
    label: 'Guests'
    type: 'number'
    definition: @aql kitchen_service_day.covers_amount ;;
    format: '#,##0'
    description: 'Guests served. Every guest eats the whole tasting menu.'
  }

  metric food_revenue_per_guest {
    label: 'Food Revenue per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(revenue, covers) ;;
    format: '#,##0'
    description: 'What the tasting menu brings in per guest. Drinks pairings are added in spend per guest.'
  }

  metric food_cost_per_guest {
    label: 'Food Cost per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(ingredient_cost + waste_cost, covers) ;;
    format: '#,##0'
    description: 'Ingredient cost plus waste cost, per guest.'
  }

  metric food_margin_per_guest {
    label: 'Food Margin per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(dish_margin, covers) ;;
    format: '#,##0'
    description: 'Dish margin per guest. Food only: drinks never enter dish margin.'
  }

  metric waste_per_guest {
    label: 'Waste Cost per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(waste_cost, covers) ;;
    format: '#,##0.00'
    description: 'Waste cost divided by guests, a fairer comparison than total waste between a quiet and a busy period.'
  }

  metric pairing_guests {
    label: 'Pairing Guests'
    type: 'number'
    definition: @aql kitchen_pairing_day.guests_amount ;;
    format: '#,##0'
    description: 'Guests who took a drinks pairing. A guest takes at most one.'
  }

  metric pairing_revenue {
    label: 'Pairing Revenue (USD)'
    type: 'number'
    definition: @aql kitchen_pairing_day.revenue_amount ;;
    format: '#,##0'
    description: 'What guests paid for drinks pairings.'
  }

  metric pairing_cost {
    label: 'Pairing Cost (USD)'
    type: 'number'
    definition: @aql kitchen_pairing_day.cost_amount ;;
    format: '#,##0'
    description: 'What the drinks cost the restaurant.'
  }

  metric pairing_margin {
    label: 'Pairing Margin (USD)'
    type: 'number'
    definition: @aql pairing_revenue - pairing_cost ;;
    format: '#,##0'
    description: 'Pairing revenue minus pairing cost. Drinks never enter dish margin.'
  }

  metric pairing_price {
    label: 'Average Pairing Price (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_revenue, pairing_guests) ;;
    format: '#,##0'
    description: 'What a guest pays for one pairing, on average over the days in view.'
  }

  metric attach_rate {
    label: 'Pairing Take-up (%)'
    type: 'number'
    definition: @aql 100 * safe_divide(pairing_guests, covers) ;;
    format: '0.0'
    description: 'Share of guests who took a pairing. By pairing type it is the share who took that one.'
  }

  metric spend_per_guest {
    label: 'Spend per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(revenue + pairing_revenue + drinks_order_revenue, covers) ;;
    format: '#,##0'
    description: 'Food revenue plus drinks (pairings and drinks ordered separately), per guest.'
  }

  metric pairing_revenue_per_guest {
    label: 'Pairing Revenue per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_revenue, covers) ;;
    format: '#,##0'
    description: 'Drinks pairing revenue per guest served (not per pairing guest).'
  }

  metric pairing_cost_per_guest {
    label: 'Pairing Cost per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_cost, covers) ;;
    format: '#,##0.00'
    description: 'Drinks cost per guest served.'
  }

  metric pairing_margin_per_guest {
    label: 'Pairing Margin per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_margin, covers) ;;
    format: '#,##0'
    description: 'Drinks margin per guest served.'
  }

  metric total_margin_per_cover {
    label: 'Total Margin per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(dish_margin + pairing_margin + drinks_order_margin - drinks_waste_cost, covers) ;;
    format: '#,##0'
    description: 'Food margin plus drinks margin (pairings and drinks ordered separately, after drinks waste), per guest. Dish margin itself stays food only.'
  }

  metric drinks_order_guests {
    label: 'Guests Who Ordered Drinks'
    type: 'number'
    definition: @aql kitchen_drink_orders.guests_amount ;;
    format: '#,##0'
    description: 'Guests without a pairing who ordered at least one drink. A pairing already includes the drinks.'
  }

  metric drinks_order_revenue {
    label: 'Drinks Ordered Revenue (USD)'
    type: 'number'
    definition: @aql kitchen_drink_orders.revenue_amount ;;
    format: '#,##0'
    description: 'What guests paid for drinks ordered separately from any pairing.'
  }

  metric drinks_order_cost {
    label: 'Drinks Ordered Cost (USD)'
    type: 'number'
    definition: @aql kitchen_drink_orders.cost_amount ;;
    format: '#,##0'
    description: 'What those drinks cost the restaurant.'
  }

  metric drinks_order_margin {
    label: 'Drinks Ordered Margin (USD)'
    type: 'number'
    definition: @aql drinks_order_revenue - drinks_order_cost ;;
    format: '#,##0'
  }

  metric drinks_order_take {
    label: 'Ordered Drinks Take-up (%)'
    type: 'number'
    definition: @aql 100 * safe_divide(drinks_order_guests, covers) ;;
    format: '0.0'
    description: 'Share of all guests who ordered drinks separately (guests without a pairing).'
  }

  metric drinks_order_spend {
    label: 'Spend per Guest Who Ordered (USD)'
    type: 'number'
    definition: @aql safe_divide(drinks_order_revenue, drinks_order_guests) ;;
    format: '#,##0'
    description: 'What a guest who ordered drinks spent on them, on average.'
  }

  metric drinks_cost_per_guest {
    label: 'Drinks Cost per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_cost + drinks_order_cost, covers) ;;
    format: '#,##0.00'
    description: 'Pairing cost plus ordered drinks cost, per guest served.'
  }

  metric drinks_margin_per_guest {
    label: 'Drinks Margin per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_margin + drinks_order_margin - drinks_waste_cost, covers) ;;
    format: '#,##0'
    description: 'Pairing margin plus ordered drinks margin, minus drinks waste, per guest served. Food margin takes food waste off in the same way.'
  }

  metric drinks_waste_cost {
    label: 'Drinks Waste Cost (USD)'
    type: 'number'
    definition: @aql kitchen_drink_waste.cost_amount ;;
    format: '#,##0'
    description: 'Drinks lost to open bottles, returned glasses, faulty bottles, expired stock and trim, at what they cost.'
  }

  metric drinks_waste_litres {
    label: 'Drinks Wasted (litres)'
    type: 'number'
    definition: @aql kitchen_drink_waste.litres_amount ;;
    format: '#,##0.0'
  }

  metric drinks_waste_rate {
    label: 'Drinks Waste Rate (%)'
    type: 'number'
    definition: @aql 100 * safe_divide(drinks_waste_cost, pairing_cost + drinks_order_cost + drinks_waste_cost) ;;
    format: '0.0'
    description: 'Drinks waste cost as a share of everything drinks cost the restaurant (served plus wasted).'
  }

  metric drinks_reuse_rate {
    label: 'Drinks Reuse Rate (%)'
    type: 'number'
    definition: @aql 100 * safe_divide(kitchen_drink_waste.reused_amount, drinks_waste_litres) ;;
    format: '0.0'
    description: 'Share of wasted litres that were reused (wine dregs into vinegar and cooking, trim into cordial).'
  }

  metric drinks_waste_per_guest {
    label: 'Drinks Waste per Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(drinks_waste_cost, covers) ;;
    format: '#,##0.00'
  }

  metric pairing_margin_each {
    label: 'Pairing Margin per Pairing Guest (USD)'
    type: 'number'
    definition: @aql safe_divide(pairing_margin, pairing_guests) ;;
    format: '#,##0'
    description: 'What one guest who took a pairing leaves as margin, before drinks waste.'
  }

  metric drinks_order_margin_each {
    label: 'Ordered Drinks Margin per Guest Who Ordered (USD)'
    type: 'number'
    definition: @aql safe_divide(drinks_order_margin, drinks_order_guests) ;;
    format: '#,##0'
    description: 'What one guest who ordered drinks leaves as margin, before drinks waste.'
  }

  metric kitchen_waste_kg {
    label: 'Kitchen Waste (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.kitchen_kg_amount ;;
    format: '#,##0'
    description: 'Food lost in the kitchen: storage, prep, cooking and plate. Farm loss is not included.'
  }

  metric reused_kg {
    label: 'Reused (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.reused_kg_amount ;;
    format: '#,##0'
    description: 'Kitchen waste that went into stock, cordial, fond or the staff meal instead of the bin.'
  }

  metric compost_kg {
    label: 'Composted (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.compost_kg_amount ;;
    format: '#,##0'
    description: 'Kitchen waste composted into fertiliser.'
  }

  metric feed_kg {
    label: 'Animal Feed (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.feed_kg_amount ;;
    format: '#,##0'
    description: 'Kitchen waste sent as animal feed. Safe, unsalted scraps only.'
  }

  metric landfill_kg {
    label: 'Landfill (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.landfill_kg_amount ;;
    format: '#,##0'
    description: 'Kitchen waste thrown away: the true loss.'
  }

  metric landfill_cost {
    label: 'Landfill Cost (USD)'
    type: 'number'
    definition: @aql kitchen_waste_flow.landfill_cost_amount ;;
    format: '#,##0'
    description: 'What the thrown-away kilos cost, at the ingredient price of that month.'
  }

  metric diversion_rate {
    label: 'Waste Diverted (%)'
    type: 'number'
    definition: @aql safe_divide(reused_kg + compost_kg + feed_kg, kitchen_waste_kg) * 100 ;;
    format: '#,##0.0'
    description: 'Share of kitchen waste that was reused, composted or fed to animals instead of thrown away. Farm loss is not counted.'
  }

  metric landfill_rate {
    label: 'Landfill Rate (%)'
    type: 'number'
    definition: @aql safe_divide(landfill_kg, kitchen_waste_kg) * 100 ;;
    format: '#,##0.0'
    description: 'Share of kitchen waste that was thrown away. The remainder of the diversion rate.'
  }

  metric value_recovered {
    label: 'Value Recovered (USD)'
    type: 'number'
    definition: @aql kitchen_waste_flow.reused_cost_amount ;;
    format: '#,##0'
    description: 'What the reused kilos would have cost to buy again, one for one at that month\'s ingredient price. Compost and feed recover nothing.'
  }

  metric net_waste_cost {
    label: 'Net Waste Cost (USD)'
    type: 'number'
    definition: @aql waste_cost - value_recovered ;;
    format: '#,##0'
    description: 'Waste cost minus the value recovered by reuse. Dish margin is unchanged: reuse only lowers this figure.'
  }

  metric farm_loss_kg {
    label: 'Farm Loss (kg)'
    type: 'number'
    definition: @aql kitchen_waste_flow.farm_kg_amount ;;
    format: '#,##0'
    description: 'Food lost on the farm or in transport before it reaches the kitchen. The supplier absorbs it, so it is never charged to the kitchen.'
  }
}
