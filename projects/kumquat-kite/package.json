{
  "name": "kumquat-kite-poc",
  "private": true,
  "version": "0.1.0",
  "description": "Kumquat Kite Studio (fictional) lightweight ERP+CRM POC: plain PostgreSQL (Docker Compose locally) + a small Node API + Anfra governed analytics. Synthetic demo data only.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "db:up": "docker compose --env-file .env.local up --detach --wait postgres",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "node scripts/migrate.mjs",
    "db:status": "node scripts/migrate.mjs --status",
    "seed": "node scripts/seed_demo.mjs --if-empty",
    "seed:reset": "node scripts/seed_demo.mjs --reset --yes",
    "setup:anfra": "node scripts/configure_anfra.mjs",
    "check:reader": "node scripts/check_anfra_role.mjs",
    "anfra:validate": "cd anfra && ../bin/anfra validate",
    "import": "node scripts/import_snapshot.mjs",
    "reconcile": "node scripts/reconcile.mjs",
    "start": "node server/server.mjs",
    "build": "node server/build.mjs",
    "test": "npm run test:unit && npm run test:api && npm run test:ui",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:api": "node --test --test-concurrency=1 tests/api.test.mjs",
    "test:ui": "playwright test",
    "test:server": "node scripts/test_server.mjs",
    "typecheck": "tsc -p web/src/ui/tsconfig.json",
    "check:panels": "node scripts/check_panels.mjs",
    "export": "node scripts/export_csv.mjs"
  },
  "dependencies": {
    "@holistics/anfra-sdk": "0.8.0",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@playwright/test": "1.54.0",
    "@tailwindcss/cli": "4.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.2.4",
    "esbuild": "0.25.10",
    "lucide-react": "1.21.0",
    "radix-ui": "1.4.3",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.2"
  }
}
