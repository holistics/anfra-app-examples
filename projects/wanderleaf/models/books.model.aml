Model books {
  type: 'table'
  label: 'Books'
  description: 'The catalogue: one row per title. Title and author are display names: well-loved books mapped onto the synthetic catalogue by book_id (genre, price and every sale unchanged).'
  data_source_name: 'wanderleaf'
  table_name: 'books'

  dimension book_id {
    label: 'Book Id'
    type: 'number'
    primary_key: true
    definition: @sql {{ #SOURCE.book_id }};;
  }
  dimension title {
    label: 'Title'
    type: 'text'
    definition: @sql
    CASE {{ #SOURCE.book_id }}
      WHEN 1 THEN 'The Adventures of Sherlock Holmes'
      WHEN 4 THEN 'Crime and Punishment'
      WHEN 5 THEN 'Rebecca'
      WHEN 6 THEN 'And Then There Were None'
      WHEN 7 THEN 'Murder on the Orient Express'
      WHEN 8 THEN 'The Name of the Rose'
      WHEN 9 THEN 'The Big Sleep'
      WHEN 10 THEN 'The Girl with the Dragon Tattoo'
      WHEN 11 THEN 'On the Road'
      WHEN 12 THEN 'Into the Wild'
      WHEN 14 THEN 'A Year in Provence'
      WHEN 15 THEN 'In Patagonia'
      WHEN 17 THEN 'Notes from a Small Island'
      WHEN 18 THEN 'The Motorcycle Diaries'
      WHEN 20 THEN 'Love in the Time of Cholera'
      WHEN 24 THEN 'Gone with the Wind'
      WHEN 26 THEN 'Anna Karenina'
      WHEN 27 THEN 'The Great Gatsby'
      WHEN 28 THEN 'Charlotte''s Web'
      WHEN 32 THEN 'The Little Prince'
      WHEN 33 THEN 'Matilda'
      WHEN 34 THEN 'Harry Potter and the Philosopher''s Stone'
      WHEN 36 THEN 'Winnie-the-Pooh'
      WHEN 37 THEN 'Sapiens'
      WHEN 39 THEN 'The Diary of a Young Girl'
      WHEN 40 THEN 'Guns, Germs, and Steel'
      WHEN 41 THEN 'A Short History of Nearly Everything'
      WHEN 42 THEN 'The Guns of August'
      WHEN 43 THEN 'Mastering the Art of French Cooking'
      WHEN 45 THEN 'Salt, Fat, Acid, Heat'
      WHEN 46 THEN 'Kitchen Confidential'
      WHEN 47 THEN 'The Joy of Cooking'
      WHEN 48 THEN 'How to Eat'
      WHEN 49 THEN 'The Lord of the Rings'
      WHEN 50 THEN 'The Hobbit'
      WHEN 52 THEN 'The Lion, the Witch and the Wardrobe'
      WHEN 53 THEN 'A Game of Thrones'
      WHEN 55 THEN 'The Odyssey'
      WHEN 57 THEN 'The Divine Comedy'
      WHEN 58 THEN 'The Waste Land'
      WHEN 59 THEN 'Paradise Lost'
      WHEN 60 THEN 'The Iliad'
      WHEN 61 THEN 'Silent Spring'
      WHEN 63 THEN 'On the Origin of Species'
      WHEN 64 THEN 'H Is for Hawk'
      WHEN 65 THEN 'The Hidden Life of Trees'
      WHEN 68 THEN 'Nineteen Eighty-Four'
      WHEN 70 THEN 'Dune'
      WHEN 71 THEN 'Brave New World'
      WHEN 73 THEN 'The Republic'
      WHEN 74 THEN 'Thus Spoke Zarathustra'
      WHEN 75 THEN 'Sophie''s World'
      WHEN 76 THEN 'The Art of War'
      WHEN 77 THEN 'The Prince'
      WHEN 38 THEN 'The Rise and Fall of the Third Reich'
      WHEN 44 THEN 'The Silver Spoon'
      WHEN 13 THEN 'Wild'
      ELSE {{ #SOURCE.title }}
    END;;
  }
  dimension author {
    label: 'Author'
    type: 'text'
    definition: @sql
    CASE {{ #SOURCE.book_id }}
      WHEN 1 THEN 'Arthur Conan Doyle'
      WHEN 4 THEN 'Fyodor Dostoevsky'
      WHEN 5 THEN 'Daphne du Maurier'
      WHEN 6 THEN 'Agatha Christie'
      WHEN 7 THEN 'Agatha Christie'
      WHEN 8 THEN 'Umberto Eco'
      WHEN 9 THEN 'Raymond Chandler'
      WHEN 10 THEN 'Stieg Larsson'
      WHEN 11 THEN 'Jack Kerouac'
      WHEN 12 THEN 'Jon Krakauer'
      WHEN 14 THEN 'Peter Mayle'
      WHEN 15 THEN 'Bruce Chatwin'
      WHEN 17 THEN 'Bill Bryson'
      WHEN 18 THEN 'Ernesto Che Guevara'
      WHEN 20 THEN 'Gabriel García Márquez'
      WHEN 24 THEN 'Margaret Mitchell'
      WHEN 26 THEN 'Leo Tolstoy'
      WHEN 27 THEN 'F. Scott Fitzgerald'
      WHEN 28 THEN 'E. B. White'
      WHEN 32 THEN 'Antoine de Saint-Exupéry'
      WHEN 33 THEN 'Roald Dahl'
      WHEN 34 THEN 'J. K. Rowling'
      WHEN 36 THEN 'A. A. Milne'
      WHEN 37 THEN 'Yuval Noah Harari'
      WHEN 39 THEN 'Anne Frank'
      WHEN 40 THEN 'Jared Diamond'
      WHEN 41 THEN 'Bill Bryson'
      WHEN 42 THEN 'Barbara Tuchman'
      WHEN 43 THEN 'Julia Child'
      WHEN 45 THEN 'Samin Nosrat'
      WHEN 46 THEN 'Anthony Bourdain'
      WHEN 47 THEN 'Irma S. Rombauer'
      WHEN 48 THEN 'Nigella Lawson'
      WHEN 49 THEN 'J. R. R. Tolkien'
      WHEN 50 THEN 'J. R. R. Tolkien'
      WHEN 52 THEN 'C. S. Lewis'
      WHEN 53 THEN 'George R. R. Martin'
      WHEN 55 THEN 'Homer'
      WHEN 57 THEN 'Dante Alighieri'
      WHEN 58 THEN 'T. S. Eliot'
      WHEN 59 THEN 'John Milton'
      WHEN 60 THEN 'Homer'
      WHEN 61 THEN 'Rachel Carson'
      WHEN 63 THEN 'Charles Darwin'
      WHEN 64 THEN 'Helen Macdonald'
      WHEN 65 THEN 'Peter Wohlleben'
      WHEN 68 THEN 'George Orwell'
      WHEN 70 THEN 'Frank Herbert'
      WHEN 71 THEN 'Aldous Huxley'
      WHEN 73 THEN 'Plato'
      WHEN 74 THEN 'Friedrich Nietzsche'
      WHEN 75 THEN 'Jostein Gaarder'
      WHEN 76 THEN 'Sun Tzu'
      WHEN 77 THEN 'Niccolò Machiavelli'
      WHEN 38 THEN 'William L. Shirer'
      WHEN 44 THEN 'Phaidon'
      WHEN 13 THEN 'Cheryl Strayed'
      ELSE {{ #SOURCE.author }}
    END;;
  }
  dimension genre {
    label: 'Book Genre'
    type: 'text'
    hidden: true
    definition: @sql {{ #SOURCE.genre }};;
  }
  dimension list_price {
    label: 'List Price'
    type: 'number'
    definition: @sql {{ #SOURCE.list_price }};;
  }
}
