Model nether_library {
  type: 'table'
  label: 'Library'
  data_source_name: 'nether'
  table_name: 'library'

  dimension library_id {
    label: 'Library Id'
    type: 'text'
    primary_key: true
    definition: @sql {{ #SOURCE.library_id }} ;;
  }
  dimension name {
    label: 'Name'
    type: 'text'
    definition: @sql {{ #SOURCE.name }} ;;
  }
  dimension location {
    label: 'Location'
    type: 'text'
    definition: @sql {{ #SOURCE.location }} ;;
  }
}
