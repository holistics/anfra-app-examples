Model scenario_day {
  type: 'query'
  label: 'Planner: Days'
  description: '''One row per set of settings and planned day, from tomorrow to race day: session (easy, long, threshold, intervals, strength, race, rest), km, target pace and what to run.

Every setting is a dimension: filter each to one value (race_id, runs_per_week, peak_km, quality, long_max_km, ramp_pct, taper_weeks, front_loaded, tune_up, start_km), or the model computes every combination of the ones left open.'''
  data_source_name: 'garmin'
  query: @sql
    select g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km,
           d.day, d.week, d.phase, d.session, d.planned_km, d.planned_min, d.km_est, d.target_pace_s_per_km, d.notes
    from garmin.scenario_grid g
    cross join lateral (select garmin.scn_scenario(g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km) as j) x
    cross join lateral jsonb_to_recordset(x.j->'days') d(day date, week int, phase text, session text, planned_km float8, planned_min float8, km_est float8, target_pace_s_per_km float8, notes text)
  ;;

  dimension race_id {
    label: 'Race ID'
    type: 'number'
    description: 'Goal race (an upcoming race)'
    hidden: true
    definition: @sql {{ #SOURCE.race_id }};;
  }
  dimension runs_per_week {
    label: 'Runs per week'
    type: 'number'
    description: 'Setting: runs a week, the long run and quality sessions included (3 to 7)'
    definition: @sql {{ #SOURCE.runs_per_week }};;
  }
  dimension peak_km {
    label: 'Biggest week (km)'
    type: 'number'
    description: 'Setting: the biggest week the plan may reach (15 to 160 km)'
    definition: @sql {{ #SOURCE.peak_km }};;
  }
  dimension quality {
    label: 'Quality sessions'
    type: 'number'
    description: 'Setting: quality sessions a week (0 to 2; at most runs per week minus 1)'
    definition: @sql {{ #SOURCE.quality }};;
  }
  dimension long_max_km {
    label: 'Longest long run (km)'
    type: 'number'
    description: 'Setting: the longest long run (8 to 42 km)'
    definition: @sql {{ #SOURCE.long_max_km }};;
  }
  dimension ramp_pct {
    label: 'Weekly increase (%)'
    type: 'number'
    description: 'Setting: how much a build week may rise over the one before (0 to 30 %)'
    definition: @sql {{ #SOURCE.ramp_pct }};;
  }
  dimension taper_weeks {
    label: 'Taper (weeks)'
    type: 'number'
    description: 'Setting: taper length, race week included (1 to 3)'
    definition: @sql {{ #SOURCE.taper_weeks }};;
  }
  dimension front_loaded {
    label: 'Front-loaded'
    type: 'number'
    description: 'Setting: build-up, 0 gradual (biggest week at the peak), 1 front-loaded (biggest week as early as the weekly increase allows)'
    definition: @sql {{ #SOURCE.front_loaded }};;
  }
  dimension tune_up {
    label: 'Tune-up race'
    type: 'number'
    description: 'Setting: 1 for a tune-up race 6 weeks before race week (half marathon or longer, 12+ weeks to go)'
    definition: @sql {{ #SOURCE.tune_up }};;
  }
  dimension start_km {
    label: 'This week (km)'
    type: 'number'
    description: 'Setting: this week’s km, the plan’s starting load (10 to 160, in steps of 0.1)'
    definition: @sql {{ #SOURCE.start_km }};;
  }
  dimension day {
    label: 'Day'
    type: 'date'
    description: 'Day of the planned day'
    definition: @sql {{ #SOURCE.day }};;
  }
  dimension week {
    label: 'Week'
    type: 'number'
    description: 'Week of the planned day'
    definition: @sql {{ #SOURCE.week }};;
  }
  dimension phase {
    label: 'Phase'
    type: 'text'
    description: 'Phase of the planned day'
    definition: @sql {{ #SOURCE.phase }};;
  }
  dimension session {
    label: 'Session'
    type: 'text'
    description: 'Session of the planned day'
    definition: @sql {{ #SOURCE.session }};;
  }
  dimension planned_km {
    label: 'Planned km'
    type: 'number'
    description: 'Planned km of the planned day'
    definition: @sql {{ #SOURCE.planned_km }};;
  }
  dimension planned_min {
    label: 'Planned minutes'
    type: 'number'
    description: 'Planned minutes of the planned day'
    definition: @sql {{ #SOURCE.planned_min }};;
  }
  dimension km_est {
    label: 'Km (estimated)'
    type: 'number'
    description: 'Km (estimated) of the planned day'
    definition: @sql {{ #SOURCE.km_est }};;
  }
  dimension target_pace_s_per_km {
    label: 'Target pace (s/km)'
    type: 'number'
    description: 'Target pace (s/km) of the planned day'
    definition: @sql {{ #SOURCE.target_pace_s_per_km }};;
  }
  dimension notes {
    label: 'Notes'
    type: 'text'
    description: 'Notes of the planned day'
    definition: @sql {{ #SOURCE.notes }};;
  }
}
