Model scenario_phase {
  type: 'query'
  label: 'Planner: Phases'
  description: '''One row per set of settings and phase of the plan (sharpen, base, build, peak, taper, race week; a recovery week belongs to its phase): its focus, and what it should leave you with at its last day (race fitness, marathon shape, threshold pace, race time, form).

Every setting is a dimension: filter each to one value (race_id, runs_per_week, peak_km, quality, long_max_km, ramp_pct, taper_weeks, front_loaded, tune_up, start_km), or the model computes every combination of the ones left open.'''
  data_source_name: 'garmin'
  query: @sql
    select g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km,
           p->>'phase' as phase, p->>'title' as title, p->>'purpose' as purpose, (p->>'from_week')::int as from_week, (p->>'to_week')::int as to_week, (p->>'start')::date as start_day, (p->>'end')::date as end_day, (p->>'km_from')::float8 as km_from, (p->>'km_to')::float8 as km_to, (p->>'long_to')::float8 as long_to, (p->'expected'->>'vo2')::float8 as exp_vo2, (p->'expected'->>'shape')::float8 as exp_shape, (p->'expected'->>'threshold_pace_s_per_km')::float8 as exp_threshold_pace, (p->'expected'->>'race_time_s')::float8 as exp_race_time_s, (p->'expected'->>'ctl')::float8 as exp_ctl, (p->'expected'->>'atl')::float8 as exp_atl, (p->'expected'->>'form_share')::float8 as exp_form_share
    from garmin.scenario_grid g
    cross join lateral (select garmin.scn_scenario(g.race_id, g.runs_per_week, g.peak_km, g.quality, g.long_max_km, g.ramp_pct, g.taper_weeks, g.front_loaded, g.tune_up, g.start_km) as j) x
    cross join lateral jsonb_array_elements(x.j->'phases') p
  ;;

  dimension race_id {
    label: 'Race ID'
    type: 'number'
    description: 'Goal race (an upcoming race)'
    hidden: true
    definition: @sql {{ #SOURCE.race_id }};;
  }
  dimension runs_per_week {
    label: 'Runs per week'
    type: 'number'
    description: 'Setting: runs a week, the long run and quality sessions included (3 to 7)'
    definition: @sql {{ #SOURCE.runs_per_week }};;
  }
  dimension peak_km {
    label: 'Biggest week (km)'
    type: 'number'
    description: 'Setting: the biggest week the plan may reach (15 to 160 km)'
    definition: @sql {{ #SOURCE.peak_km }};;
  }
  dimension quality {
    label: 'Quality sessions'
    type: 'number'
    description: 'Setting: quality sessions a week (0 to 2; at most runs per week minus 1)'
    definition: @sql {{ #SOURCE.quality }};;
  }
  dimension long_max_km {
    label: 'Longest long run (km)'
    type: 'number'
    description: 'Setting: the longest long run (8 to 42 km)'
    definition: @sql {{ #SOURCE.long_max_km }};;
  }
  dimension ramp_pct {
    label: 'Weekly increase (%)'
    type: 'number'
    description: 'Setting: how much a build week may rise over the one before (0 to 30 %)'
    definition: @sql {{ #SOURCE.ramp_pct }};;
  }
  dimension taper_weeks {
    label: 'Taper (weeks)'
    type: 'number'
    description: 'Setting: taper length, race week included (1 to 3)'
    definition: @sql {{ #SOURCE.taper_weeks }};;
  }
  dimension front_loaded {
    label: 'Front-loaded'
    type: 'number'
    description: 'Setting: build-up, 0 gradual (biggest week at the peak), 1 front-loaded (biggest week as early as the weekly increase allows)'
    definition: @sql {{ #SOURCE.front_loaded }};;
  }
  dimension tune_up {
    label: 'Tune-up race'
    type: 'number'
    description: 'Setting: 1 for a tune-up race 6 weeks before race week (half marathon or longer, 12+ weeks to go)'
    definition: @sql {{ #SOURCE.tune_up }};;
  }
  dimension start_km {
    label: 'This week (km)'
    type: 'number'
    description: 'Setting: this week’s km, the plan’s starting load (10 to 160, in steps of 0.1)'
    definition: @sql {{ #SOURCE.start_km }};;
  }
  dimension phase {
    label: 'Phase'
    type: 'text'
    description: 'Phase: the phase of the plan'
    definition: @sql {{ #SOURCE.phase }};;
  }
  dimension title {
    label: 'Title'
    type: 'text'
    description: 'Title: the phase of the plan'
    definition: @sql {{ #SOURCE.title }};;
  }
  dimension purpose {
    label: 'Purpose'
    type: 'text'
    description: 'Purpose: the phase of the plan'
    definition: @sql {{ #SOURCE.purpose }};;
  }
  dimension from_week {
    label: 'From week'
    type: 'number'
    description: 'From week: the phase of the plan'
    definition: @sql {{ #SOURCE.from_week }};;
  }
  dimension to_week {
    label: 'To week'
    type: 'number'
    description: 'To week: the phase of the plan'
    definition: @sql {{ #SOURCE.to_week }};;
  }
  dimension start_day {
    label: 'Start'
    type: 'date'
    description: 'Start: the phase of the plan'
    definition: @sql {{ #SOURCE.start_day }};;
  }
  dimension end_day {
    label: 'End'
    type: 'date'
    description: 'End: the phase of the plan'
    definition: @sql {{ #SOURCE.end_day }};;
  }
  dimension km_from {
    label: 'Km at start'
    type: 'number'
    description: 'Km at start: the phase of the plan'
    definition: @sql {{ #SOURCE.km_from }};;
  }
  dimension km_to {
    label: 'Km at end'
    type: 'number'
    description: 'Km at end: the phase of the plan'
    definition: @sql {{ #SOURCE.km_to }};;
  }
  dimension long_to {
    label: 'Long run at end (km)'
    type: 'number'
    description: 'Long run at end (km): the phase of the plan'
    definition: @sql {{ #SOURCE.long_to }};;
  }
  dimension exp_vo2 {
    label: 'Race fitness after'
    type: 'number'
    description: 'Race fitness after: the phase of the plan'
    definition: @sql {{ #SOURCE.exp_vo2 }};;
  }
  dimension exp_shape {
    label: 'Marathon shape after (%)'
    type: 'number'
    description: 'Marathon shape after (%): the phase of the plan'
    definition: @sql {{ #SOURCE.exp_shape }};;
  }
  dimension exp_threshold_pace {
    label: 'Threshold pace after (s/km)'
    type: 'number'
    description: 'Threshold pace after (s/km): the phase of the plan'
    definition: @sql {{ #SOURCE.exp_threshold_pace }};;
  }
  dimension exp_race_time_s {
    label: 'Race time after (s)'
    type: 'number'
    description: 'Race time after (s): the phase of the plan'
    definition: @sql {{ #SOURCE.exp_race_time_s }};;
  }
  dimension exp_ctl {
    label: 'Fitness after'
    type: 'number'
    description: 'Fitness after: the phase of the plan'
    definition: @sql {{ #SOURCE.exp_ctl }};;
  }
  dimension exp_atl {
    label: 'Fatigue after'
    type: 'number'
    description: 'Fatigue after: the phase of the plan'
    definition: @sql {{ #SOURCE.exp_atl }};;
  }
  dimension exp_form_share {
    label: 'Form share after'
    type: 'number'
    description: 'Form share after: the phase of the plan'
    definition: @sql {{ #SOURCE.exp_form_share }};;
  }
}
