Dataset perfume_composer {
  label: 'Perfume Composer'
  description: '''
# What this dataset is for

Costing and balancing perfume formulas: what a batch costs, how it splits across
top, heart and base notes and across scent families, which ingredients are over
their IFRA limit, and what it earns.

## What it cannot answer

- How a blend actually smells: interactions between ingredients are not modeled.
  "Impact" is strength x share, a proxy for how loud an ingredient is.
- Real compliance. IFRA limits here are one number per ingredient, and synthetic.

## Data provenance

**Synthetic.** Generated by `scripts/generate_data.py`.
'''
  data_source_name: 'local'

  models: [ingredients, formulas, formula_lines, line_families, draft_options, draft_families, settings, business_options, ingredient_families, draft_curve, launches, draft_launch, family_season, price_points, structure_targets, accord_parts, draft_accords, fixative_options, boost_options, ingredient_pairs, draft_allergens]

  relationships: [
    relationship(formula_lines.formula_id > formulas.formula_id, true),
    relationship(line_families.formula_id > formulas.formula_id, true),
    relationship(draft_options.k > settings.k, true),
    relationship(settings.k > business_options.k, true),
    relationship(ingredient_families.ingredient_id > ingredients.ingredient_id, true),
    relationship(draft_families.option_id > draft_options.option_id, true),
    relationship(draft_curve.option_id > draft_options.option_id, true),
    relationship(draft_launch.option_id > draft_options.option_id, true),
    relationship(draft_launch.launch_id > launches.launch_id, true),
    relationship(family_season.family > draft_families.family, true),
    relationship(price_points.k > settings.k, true),
    relationship(draft_accords.option_id > draft_options.option_id, true),
    relationship(fixative_options.option_id > draft_options.option_id, true),
    relationship(boost_options.option_id > draft_options.option_id, true),
    relationship(draft_allergens.option_id > draft_options.option_id, true),
  ]

  metric ingredient_cost {
    label: 'Ingredient Cost (USD)'
    type: 'number'
    definition: @aql formula_lines.oil_cost ;;
    format: '#,##0.00'
    description: 'Raw ingredients for the whole batch.'
  }

  metric total_cost {
    label: 'Total Cost (USD)'
    type: 'number'
    definition: @aql ingredient_cost + formulas.packaging_amount ;;
    format: '#,##0.00'
    description: 'Ingredients plus packaging. Ethanol is ignored.'
  }

  metric unit_cost {
    label: 'Cost per Bottle (USD)'
    type: 'number'
    definition: @aql safe_divide(total_cost, formulas.bottles) ;;
    format: '#,##0.00'
  }

  metric revenue {
    label: 'Revenue (USD)'
    type: 'number'
    definition: @aql formulas.revenue_amount ;;
    format: '#,##0'
  }

  metric profit {
    label: 'Profit (USD)'
    type: 'number'
    definition: @aql revenue - total_cost ;;
    format: '#,##0'
  }

  metric margin_pct {
    label: 'Margin (%)'
    type: 'number'
    definition: @aql safe_divide(profit, revenue) * 100 ;;
    format: '#,##0.0'
  }

  metric break_even_bottles {
    label: 'Break-even Bottles'
    type: 'number'
    definition: @aql safe_divide(total_cost, safe_divide(revenue, formulas.bottles)) ;;
    format: '#,##0'
    description: 'Bottles that must sell at full price to recover the whole batch cost.'
  }

  // ---------------------------------------------------------------------
  // The draft formula: rows of draft_options the reader has selected, costed
  // against the one batch setting the dropdowns leave.
  // ---------------------------------------------------------------------

  metric draft_parts {
    label: 'Draft Total Parts'
    type: 'number'
    definition: @aql draft_options.total_parts ;;
  }

  metric draft_cost_per_ml {
    label: 'Draft Blend Cost per ml (USD)'
    type: 'number'
    definition: @aql safe_divide(draft_options.parts_cost, draft_parts) ;;
    format: '#,##0.00'
    description: 'Parts-weighted average cost of one ml of the blend.'
  }

  metric draft_ingredient_cost {
    label: 'Draft Ingredient Cost (USD)'
    type: 'number'
    definition: @aql draft_cost_per_ml * settings.blend_ml ;;
    format: '#,##0.00'
  }

  // ---- Per ingredient: what each line contributes, and what to warn about ----
  // Use these with draft_options.ingredient as a dimension.

  metric draft_pct_of_blend {
    label: 'Share of Blend (%)'
    type: 'number'
    definition: @aql safe_divide(draft_options.total_parts, draft_parts | exclude_grains(draft_options.ingredient, draft_options.tier, draft_options.parts)) * 100 ;;
    format: '#,##0.0'
    description: 'Parts over all parts in the draft.'
  }

  metric draft_line_cost {
    label: 'Line Cost (USD)'
    type: 'number'
    definition: @aql safe_divide(draft_options.parts_cost, draft_parts | exclude_grains(draft_options.ingredient, draft_options.tier, draft_options.parts)) * settings.blend_ml ;;
    format: '#,##0.00'
    description: 'What this ingredient costs in the whole batch.'
  }

  metric draft_pct_of_product {
    label: 'Share of Finished Bottle (%)'
    type: 'number'
    definition: @aql draft_pct_of_blend * settings.concentration_avg / 100 ;;
    format: '#,##0.00'
    description: 'Blend share x concentration: what an IFRA limit is measured against.'
  }

  metric draft_over_ifra {
    label: 'Over IFRA Limit'
    type: 'number'
    definition: @aql case(when: draft_pct_of_product > draft_options.max_ifra + 0.000001, then: 1, else: 0) ;;
    description: '1 when the ingredient exceeds its limit in the finished bottle.'
  }

  metric draft_impact_share {
    label: 'Impact Share (%)'
    type: 'number'
    definition: @aql safe_divide(draft_options.total_impact, draft_options.total_impact | exclude_grains(draft_options.ingredient, draft_options.tier, draft_options.parts)) * 100 ;;
    format: '#,##0.0'
    description: '''Strength x parts as a share of the whole blend's. Above about 40% an
ingredient tends to dominate and mask the rest.'''
  }

  metric draft_max_concentration {
    label: 'Concentration Where This Hits Its Limit (%)'
    type: 'number'
    definition: @aql safe_divide(draft_options.max_ifra, draft_pct_of_blend) * 100 ;;
    format: '#,##0.0'
    description: '''The highest concentration the bottle could have before this ingredient
exceeds its limit, holding the formula as it is. Above it, the ingredient is over.'''
  }

  metric draft_safe_share {
    label: 'Largest Safe Share of Blend (%)'
    type: 'number'
    hidden: true
    definition: @aql safe_divide(draft_options.max_ifra, settings.concentration_avg) * 100 ;;
    description: 'The ingredient limit restated as a share of the blend at the current concentration.'
  }

  metric draft_other_parts {
    label: 'Parts of Everything Else'
    type: 'number'
    hidden: true
    definition: @aql (draft_parts | exclude_grains(draft_options.ingredient, draft_options.tier, draft_options.parts)) - draft_options.total_parts ;;
  }

  metric draft_max_parts {
    label: 'Most Parts Allowed'
    type: 'number'
    definition: @aql case(when: draft_safe_share >= 99.9, then: 10, else: floor(2 * safe_divide(draft_safe_share, 100 - draft_safe_share) * draft_other_parts + 0.000001) / 2) ;;
    format: '#,##0.0'
    description: '''The most parts of this ingredient that keep it under its IFRA limit at the
current concentration, with every other ingredient left as it is. Rounded down to the
half part the composer steps in.'''
  }

  metric draft_dominates {
    label: 'Dominates Blend'
    type: 'number'
    definition: @aql case(when: draft_impact_share > 40, then: 1, else: 0) ;;
  }

  metric draft_fades_fast {
    label: 'Fades Fast'
    type: 'number'
    definition: @aql case(when: safe_divide(draft_options.parts_longevity, draft_options.total_parts) < 2, then: 1, else: 0) ;;
    description: '1 when the ingredient lasts under two hours on skin.'
  }

  // ---- Per tier and per family ----

  metric draft_tier_pct {
    label: 'Tier Share (%)'
    type: 'number'
    definition: @aql safe_divide(draft_options.total_parts, draft_parts | exclude_grains(draft_options.tier, draft_options.ingredient, draft_options.parts)) * 100 ;;
    format: '#,##0.0'
    description: 'Use with the tier as the only dimension.'
  }

  metric draft_family_pct {
    label: 'Family Share (%)'
    type: 'number'
    definition: @aql safe_divide(draft_families.family_parts, draft_parts | exclude_grains(draft_families.family, draft_families.tier)) * 100 ;;
    format: '#,##0.0'
    description: 'Percent of the blend smelling of the family. Use with family, optionally tier.'
  }

  // ---- Revenue ----

  metric draft_total_cost {
    label: 'Draft Total Cost (USD)'
    type: 'number'
    definition: @aql draft_ingredient_cost + settings.packaging_amount ;;
    format: '#,##0.00'
  }

  metric draft_unit_cost {
    label: 'Draft Cost per Bottle (USD)'
    type: 'number'
    definition: @aql safe_divide(draft_total_cost, settings.bottles) ;;
    format: '#,##0.00'
  }

  metric draft_revenue {
    label: 'Draft Revenue (USD)'
    type: 'number'
    definition: @aql settings.revenue_amount ;;
    format: '#,##0'
  }

  metric draft_profit {
    label: 'Draft Profit (USD)'
    type: 'number'
    definition: @aql draft_revenue - draft_total_cost ;;
    format: '#,##0'
  }

  metric draft_margin_pct {
    label: 'Draft Margin (%)'
    type: 'number'
    definition: @aql safe_divide(draft_profit, draft_revenue) * 100 ;;
    format: '#,##0.0'
  }

  metric draft_break_even_bottles {
    label: 'Draft Break-even Bottles'
    type: 'number'
    definition: @aql safe_divide(draft_total_cost, safe_divide(draft_revenue, settings.bottles)) ;;
    format: '#,##0'
  }

  // ---------------------------------------------------------------------
  // Advanced mode: the draft costed with a full business stack. Everything is for
  // the whole batch unless the label says per bottle. Reads the one settings row and the
  // one business_options row the dropdowns leave. Synthetic, illustrative rates.
  // ---------------------------------------------------------------------

  metric adv_channel_factor {
    label: 'Price Kept After Wholesale Discount (0-1)'
    type: 'number'
    hidden: true
    definition: @aql business_options.dtc_share + (1 - business_options.dtc_share) * (1 - business_options.wholesale_discount) ;;
    description: 'Direct sales get the full retail price; wholesale sales get it less the wholesale discount.'
  }

  metric adv_net_revenue {
    label: 'Net Revenue (USD)'
    type: 'number'
    definition: @aql settings.revenue_amount * adv_channel_factor * (1 - business_options.returns_rate) ;;
    format: '#,##0'
    description: 'Retail revenue if every bottle sells, after the wholesale discount and returns.'
  }

  metric adv_wholesale_discount_amount {
    label: 'Wholesale Discount (USD)'
    type: 'number'
    definition: @aql settings.revenue_amount * (1 - adv_channel_factor) ;;
    format: '#,##0'
  }

  metric adv_returns_amount {
    label: 'Returns (USD)'
    type: 'number'
    definition: @aql settings.revenue_amount * adv_channel_factor * business_options.returns_rate ;;
    format: '#,##0'
  }

  metric adv_ingredient_cost {
    label: 'Ingredients at the Bulk Price (USD)'
    type: 'number'
    definition: @aql draft_ingredient_cost * settings.volume_mult ;;
    format: '#,##0'
    description: 'The ingredient cost at list price, less what bigger orders save: small batches pay full price, big ones get a discount.'
  }

  metric adv_packaging_cost {
    label: 'Packaging, Tier-adjusted (USD)'
    type: 'number'
    definition: @aql settings.packaging_amount * business_options.packaging_mult * settings.volume_mult ;;
    format: '#,##0'
    description: 'Packaging at the chosen tier, less what bigger orders save.'
  }

  metric adv_shipping_cost {
    label: 'Shipping (USD)'
    type: 'number'
    definition: @aql settings.bottles * (business_options.dtc_share * settings.ship_direct_rate + (1 - business_options.dtc_share) * settings.ship_wholesale_rate) ;;
    format: '#,##0'
    description: 'Direct orders are posted to each customer; wholesale goes out in bulk freight at a fraction of the cost per bottle.'
  }

  metric adv_platform_fees {
    label: 'Platform Fees (USD)'
    type: 'number'
    definition: @aql settings.revenue_amount * business_options.dtc_share * (1 - business_options.returns_rate) * business_options.platform_fee ;;
    format: '#,##0'
    description: 'Payment and storefront fees, charged on direct sales that are kept.'
  }

  metric adv_marketing_cost {
    label: 'Marketing (USD)'
    type: 'number'
    definition: @aql business_options.marketing_budget ;;
    format: '#,##0'
    description: 'The launch marketing budget, spent whether or not the batch sells. It lifts sales with diminishing returns (see the Market tab).'
  }

  // ---- Allergens: what the label must name, and what assessing them costs ----

  metric allergen_pct_product {
    label: 'Allergen Share of the Bottle (%)'
    type: 'number'
    definition: @aql safe_divide(draft_allergens.allergen_parts, draft_allergens.parts_even | exclude_grains(draft_allergens.allergen)) * settings.concentration_avg / 100 ;;
    format: '#,##0.0000'
    description: 'How much of the finished bottle is this allergen: the ingredients that hold it, by their parts and content, over all parts, times the concentration.'
  }

  metric allergen_declared {
    label: 'Allergen Must Be Declared'
    type: 'number'
    hidden: true
    definition: @aql case(when: allergen_pct_product >= 0.001, then: 1, else: 0) ;;
    description: 'One when the allergen is at 0.001% of the bottle or more, the EU leave-on threshold. Illustrative.'
  }

  metric allergen_count {
    label: 'Allergens to Declare'
    type: 'number'
    definition: @aql unique(draft_allergens.allergen) | select(v: allergen_declared) | sum(v) ;;
    format: '#,##0'
    description: 'How many fragrance allergens the label must name.'
  }

  metric adv_allergen_cost {
    label: 'Allergen Assessment (USD)'
    type: 'number'
    definition: @aql allergen_count * 150 ;;
    format: '#,##0'
    description: 'A safety assessment for each allergen that must be declared: $150 each, paid once per batch. Illustrative.'
  }

  metric adv_production_cost {
    label: 'Production Cost (USD)'
    type: 'number'
    definition: @aql adv_ingredient_cost + adv_packaging_cost + settings.alcohol_amount + settings.labor_amount + business_options.oneoff_amount + adv_allergen_cost + settings.setup_amount + settings.sample_amount ;;
    format: '#,##0'
    description: 'Everything spent making the batch before a bottle is sold: ingredients, packaging, alcohol, filling labor, batch setup, samples, one-off costs and the allergen assessment.'
  }

  metric adv_upfront_cost {
    label: 'Upfront Cost (USD)'
    type: 'number'
    definition: @aql adv_production_cost + adv_marketing_cost ;;
    format: '#,##0'
    description: 'Production cost plus the marketing budget: everything paid before the first bottle sells.'
  }

  metric adv_total_cost {
    label: 'Advanced Total Cost (USD)'
    type: 'number'
    definition: @aql adv_upfront_cost + adv_platform_fees + adv_shipping_cost ;;
    format: '#,##0'
    description: 'Upfront cost plus platform fees and shipping.'
  }

  metric adv_unit_cost {
    label: 'Advanced Cost per Bottle (USD)'
    type: 'number'
    definition: @aql safe_divide(adv_total_cost, settings.bottles) ;;
    format: '#,##0.00'
  }

  metric adv_profit {
    label: 'Advanced Profit (USD)'
    type: 'number'
    definition: @aql adv_net_revenue - adv_total_cost ;;
    format: '#,##0'
  }

  metric adv_margin_pct {
    label: 'Advanced Margin (%)'
    type: 'number'
    definition: @aql safe_divide(adv_profit, adv_net_revenue) * 100 ;;
    format: '#,##0.0'
    description: 'Profit as a share of net revenue.'
  }

  metric adv_contribution_per_bottle {
    label: 'Kept per Sold Bottle (USD)'
    type: 'number'
    definition: @aql safe_divide(adv_net_revenue - adv_platform_fees - adv_shipping_cost, settings.bottles) ;;
    format: '#,##0.00'
    description: 'What one sold bottle brings in after returns, discount, fees and shipping: the money that pays back the upfront cost.'
  }

  metric adv_break_even_bottles {
    label: 'Advanced Break-even Bottles'
    type: 'number'
    definition: @aql case(when: adv_contribution_per_bottle > 0, then: safe_divide(adv_upfront_cost, adv_contribution_per_bottle), else: null) ;;
    format: '#,##0'
    description: 'Bottles that must sell to pay back the upfront cost, marketing included. Empty when a bottle never earns more than it costs to sell.'
  }

  metric draft_ifra_breaches {
    label: 'Ingredients Over IFRA Limit'
    type: 'number'
    definition: @aql unique(draft_options.ingredient) | select(v: draft_over_ifra) | sum(v) ;;
    description: 'How many ingredients in the draft exceed their limit in the finished bottle.'
  }

  metric draft_safe_concentration {
    label: 'Highest Safe Concentration (%)'
    type: 'number'
    definition: @aql unique(draft_options.ingredient) | select(v: draft_max_concentration) | min(v) ;;
    format: '#,##0.0'
    description: 'The concentration above which some ingredient in the draft goes over its limit.'
  }

  // ---- Projection: how the draft's strength fades over the hours ----

  metric curve_opening {
    label: 'Opening Strength'
    type: 'number'
    hidden: true
    definition: @aql (draft_curve.full_strength | where(draft_curve.hour == 0)) | exclude_grains(draft_curve.hour, draft_curve.tier, draft_curve.ingredient, draft_curve.family) ;;
    description: "The whole draft at full release, with no onset and no fade: what every curve is a share of. At the moment of application the heart and base have not bloomed yet, so the opening sits below it."
  }

  metric curve_pct {
    label: 'Strength (% of full strength)'
    type: 'number'
    definition: @aql safe_divide(draft_curve.strength, curve_opening) * 100 ;;
    format: '#,##0.0'
    description: '''Strength at this hour as a share of the whole draft's full strength, so a
note's curve and the whole formula's are on one scale, and the notes add up to the whole.'''
  }

  // ---- At one hour: what the draft smells like once part of it has faded ----
  // These need draft_curve.hour in the query (a filter at one hour). The totals they divide by
  // ignore the note, family and ingredient focus, so a share is always of the whole smell.

  metric curve_share {
    label: 'Share of Smell at the Hour (%)'
    type: 'number'
    definition: @aql safe_divide(draft_curve.strength, draft_curve.strength | exclude_grains(draft_curve.tier, draft_curve.family, draft_curve.ingredient)) * 100 ;;
    format: '#,##0.0'
    description: '''How much of what you smell at the chosen hour comes from this slice. Use with
note, family or ingredient from draft_curve as the dimension and one hour as a filter. With no
hour chosen it is the share over the whole wear: every sampled hour added up.'''
  }

  metric curve_share_in_note {
    label: 'Share of Its Note at the Hour (%)'
    type: 'number'
    definition: @aql safe_divide(draft_curve.strength, draft_curve.strength | exclude_grains(draft_curve.family, draft_curve.ingredient)) * 100 ;;
    format: '#,##0.0'
    description: '''How much of a note's smell at the chosen hour comes from this slice. Use with
the note and ingredient from draft_curve as dimensions and one hour as a filter; the
ingredients of a note add up to 100.'''
  }

  metric curve_share_in_family {
    label: 'Share of Its Scent Family in the Note at the Hour (%)'
    type: 'number'
    definition: @aql safe_divide(draft_curve.strength, draft_curve.strength | exclude_grains(draft_curve.ingredient)) * 100 ;;
    format: '#,##0.0'
    description: '''How much of one scent family within one note, at the chosen hour, comes from
this ingredient. Use with the note, family and ingredient from draft_curve as dimensions and
one hour as a filter; the ingredients of a family within a note add up to 100.'''
  }

  // ---------------------------------------------------------------------
  // Advanced mode, Market view: what past launches like the draft sold. The draft is matched to the past
  // launches closest to it (the page keeps the eight closest, by launch_fit). Each launch's running total of
  // bottles is put on a common footing, averaged by closeness, and moved to the draft's own price, marketing
  // and direct share. Synthetic launches; every figure is computed here.
  // ---------------------------------------------------------------------

  metric launch_fit {
    label: 'Closeness to the Draft'
    type: 'number'
    definition: @aql draft_launch.w12 ;;
    format: '#,##0.00'
    description: 'How closely a past launch matches the draft formula by scent family. Use with the launch; the biggest are the closest.'
  }

  metric launch_going_price {
    label: 'Going Price of the Closest Launches (USD)'
    type: 'number'
    definition: @aql safe_divide(draft_launch.wp, draft_launch.w) * sqrt(settings.concentration_avg / 15.0) ;;
    format: '#,##0'
    description: 'What the launches closest to the draft would charge at the draft strength: their prices per unit of strength, the closer ones counting more, scaled to the draft concentration. A weaker formula has a lower going price.'
  }

  metric launch_price_over {
    label: 'How Far the Price Is Above the Going Price (log)'
    type: 'number'
    hidden: true
    definition: @aql case(when: settings.price_avg > launch_going_price, then: ln(settings.price_avg / launch_going_price), else: 0) ;;
  }

  metric launch_price_drag {
    label: 'Extra Drop in Log Bottles for Pricing Above the Going Price'
    type: 'number'
    hidden: true
    definition: @aql 1.5 * launch_price_over * launch_price_over ;;
    description: 'A rule, not a measurement: the effect of price measured on past launches is a straight line, but demand falls faster for a price well above what similar launches charge. Zero at or below the going price; grows with the square of how far above.'
  }

  metric launch_price_over_point {
    label: 'How Far the Compared Price Is Above the Going Price (log)'
    type: 'number'
    hidden: true
    definition: @aql case(when: launch_price_point > launch_going_price, then: ln(launch_price_point / launch_going_price), else: 0) ;;
  }

  metric launch_price_drag_point {
    label: 'Extra Drop in Log Bottles at the Compared Price'
    type: 'number'
    hidden: true
    definition: @aql 1.5 * launch_price_over_point * launch_price_over_point ;;
  }

  metric launch_shift {
    label: 'Effect of the Draft Price, Concentration, Marketing and Direct Share'
    type: 'number'
    hidden: true
    definition: @aql draft_launch.b_price * ln(settings.price_avg) + draft_launch.b_marketing * business_options.marketing_lift + draft_launch.b_direct * business_options.dtc_share * 100 + draft_launch.b_conc * settings.concentration_avg - launch_price_drag ;;
  }

  metric launch_mean {
    label: 'Closeness-weighted Level (log bottles)'
    type: 'number'
    hidden: true
    definition: @aql safe_divide(draft_launch.wv, draft_launch.w) ;;
  }

  metric launch_first_half {
    label: 'Bottles Sold in the First 6 Months, Typical'
    type: 'number'
    hidden: true
    definition: @aql exp(launch_mean) ;;
    format: '#,##0'
  }

  metric launch_spread {
    label: 'Spread Between the Launches (log bottles)'
    type: 'number'
    hidden: true
    definition: @aql sqrt(case(when: safe_divide(draft_launch.wv2, draft_launch.w) - launch_mean * launch_mean > 0, then: safe_divide(draft_launch.wv2, draft_launch.w) - launch_mean * launch_mean, else: 0)) ;;
  }

  metric launch_sold {
    label: 'Bottles Sold So Far, Typical'
    type: 'number'
    definition: @aql exp(launch_mean + launch_shift) ;;
    format: '#,##0'
    description: 'Running total of bottles in the months since launch, for a launch like the draft at its price, marketing and direct share. With the launch as a dimension it is that launch moved to the draft; without, the closeness-weighted typical.'
  }

  metric launch_sold_low {
    label: 'Bottles Sold So Far, Low'
    type: 'number'
    definition: @aql exp(launch_mean - 1.2815515655 * launch_spread + launch_shift) ;;
    format: '#,##0'
    description: 'One outcome in ten comes in below this: how far apart the closest launches were.'
  }

  metric launch_sold_high {
    label: 'Bottles Sold So Far, High'
    type: 'number'
    definition: @aql exp(launch_mean + 1.2815515655 * launch_spread + launch_shift) ;;
    format: '#,##0'
    description: 'One outcome in ten comes in above this.'
  }

  metric launch_sellout {
    label: 'Batch Sold Out, Typical'
    type: 'number'
    definition: @aql case(when: launch_sold >= settings.bottles, then: 1, else: 0) ;;
  }

  metric launch_sellout_low {
    label: 'Batch Sold Out, Low'
    type: 'number'
    definition: @aql case(when: launch_sold_low >= settings.bottles, then: 1, else: 0) ;;
  }

  metric launch_sellout_high {
    label: 'Batch Sold Out, High'
    type: 'number'
    definition: @aql case(when: launch_sold_high >= settings.bottles, then: 1, else: 0) ;;
  }

  // ---- Profit as the batch sells: bottles sold so far (capped at the batch) x what each brings in, less the whole upfront cost ----

  metric launch_profit {
    label: 'Profit So Far, Typical (USD)'
    type: 'number'
    definition: @aql (case(when: launch_sold > settings.bottles, then: settings.bottles, else: launch_sold)) * adv_contribution_per_bottle - (adv_upfront_cost | exclude_grains(draft_launch.month_no)) ;;
    format: '#,##0'
    description: 'Bottles sold so far (never more than the batch) x what each sold bottle keeps after the wholesale discount, returns, fees and shipping, less the whole upfront cost (production and marketing), including bottles still unsold. Starts negative and rises as bottles sell. Use with the month.'
  }

  metric launch_profit_low {
    label: 'Profit So Far, Low (USD)'
    type: 'number'
    definition: @aql (case(when: launch_sold_low > settings.bottles, then: settings.bottles, else: launch_sold_low)) * adv_contribution_per_bottle - (adv_upfront_cost | exclude_grains(draft_launch.month_no)) ;;
    format: '#,##0'
  }

  metric launch_profit_high {
    label: 'Profit So Far, High (USD)'
    type: 'number'
    definition: @aql (case(when: launch_sold_high > settings.bottles, then: settings.bottles, else: launch_sold_high)) * adv_contribution_per_bottle - (adv_upfront_cost | exclude_grains(draft_launch.month_no)) ;;
    format: '#,##0'
  }

  metric launch_payback {
    label: 'Paid Back, Typical'
    type: 'number'
    definition: @aql case(when: launch_profit >= 0, then: 1, else: 0) ;;
    description: '1 in the months where the typical forecast has earned back the whole upfront cost.'
  }

  metric launch_payback_low {
    label: 'Paid Back, Low'
    type: 'number'
    definition: @aql case(when: launch_profit_low >= 0, then: 1, else: 0) ;;
  }

  metric launch_payback_high {
    label: 'Paid Back, High'
    type: 'number'
    definition: @aql case(when: launch_profit_high >= 0, then: 1, else: 0) ;;
  }
  // ---- By price: the same forecast at every price the composer allows, month by month ----

  metric launch_price_point {
    label: 'Price Compared (USD)'
    type: 'number'
    definition: @aql price_points.price_avg ;;
    format: '#,##0'
    description: 'The price being compared. Use with the price.'
  }

  metric launch_price_sold_raw {
    label: 'Bottles Sold So Far at the Price'
    type: 'number'
    hidden: true
    definition: @aql exp(launch_mean + draft_launch.b_price * ln(launch_price_point) + draft_launch.b_marketing * business_options.marketing_lift + draft_launch.b_direct * business_options.dtc_share * 100 + draft_launch.b_conc * settings.concentration_avg - launch_price_drag_point) ;;
  }

  metric launch_price_sold {
    label: 'Bottles Sold So Far at the Price'
    type: 'number'
    definition: @aql case(when: launch_price_sold_raw > settings.bottles, then: settings.bottles, else: launch_price_sold_raw) ;;
    format: '#,##0'
    description: 'Typical running total at the price, capped at the batch: a batch cannot sell more than it has. Use with the price and the month.'
  }

  metric launch_price_profit {
    label: 'Profit So Far at the Price (USD)'
    type: 'number'
    definition: @aql launch_price_sold * (launch_price_point * safe_divide(adv_net_revenue - adv_platform_fees, settings.revenue_amount) - safe_divide(adv_shipping_cost, settings.bottles)) - (adv_upfront_cost | exclude_grains(price_points.price, draft_launch.month_no)) ;;
    format: '#,##0'
    description: 'Bottles sold so far x what each brings in after the wholesale discount, returns, platform fees and shipping, less the whole upfront cost (production and marketing), including bottles still unsold. Use with the price and the month.'
  }

  // ---- What each setting is worth, as measured from all past launches ----

  metric launch_effect_price {
    label: 'Price Effect (log bottles per log price)'
    type: 'number'
    definition: @aql launches.fx_price ;;
    format: '0.000'
    description: 'How bottles change as price changes, measured across all past launches. -1.4 means 10% more price, about 12% fewer bottles.'
  }

  metric launch_effect_conc {
    label: 'Concentration Effect (log bottles per point)'
    type: 'number'
    definition: @aql launches.fx_conc ;;
    format: '0.0000'
  }

  metric launch_effect_marketing {
    label: 'Marketing Effect (log bottles per log dollar)'
    type: 'number'
    definition: @aql launches.fx_marketing ;;
    format: '0.0000'
  }

  metric launch_effect_direct {
    label: 'Direct Share Effect (log bottles per point)'
    type: 'number'
    definition: @aql launches.fx_direct ;;
    format: '0.0000'
  }

  // ---- Seasonality of the scent families in the draft (display: when this kind of scent sells) ----

  metric launch_family_season {
    label: 'Seasonality of the Family (1.00 = average month)'
    type: 'number'
    definition: @aql family_season.factor_avg ;;
    format: '0.00'
    description: 'How busy a calendar month is for launches of the scent family, against its average month, measured from the past launches. Use with the family and the calendar month.'
  }

  // ---------------------------------------------------------------------
  // Advanced mode, Chemistry: is the formula well built? Structure (the notes against a balanced
  // perfume), accords (named scents the formula forms) and how long it lasts. Synthetic rules of thumb.
  // ---------------------------------------------------------------------

  metric structure_low {
    label: 'Usual Share of the Note, Low (%)'
    type: 'number'
    definition: @aql draft_options.tier_lo ;;
    format: '#,##0'
  }

  metric structure_high {
    label: 'Usual Share of the Note, High (%)'
    type: 'number'
    definition: @aql draft_options.tier_hi ;;
    format: '#,##0'
  }

  metric structure_gap {
    label: 'Distance From the Usual Share (points)'
    type: 'number'
    definition: @aql case(when: draft_tier_pct < structure_low, then: draft_tier_pct - structure_low, else: case(when: draft_tier_pct > structure_high, then: draft_tier_pct - structure_high, else: 0)) ;;
    format: '#,##0.0'
    description: 'Zero when the note takes a usual share of the blend; negative when it takes too little, positive when too much. Use with the tier as the only dimension.'
  }

  metric accord_hits {
    label: 'Ingredients of the Accord in the Draft'
    type: 'number'
    definition: @aql draft_accords.present ;;
    format: '#,##0'
    description: 'Use with the accord as the dimension.'
  }

  metric accord_size {
    label: 'Ingredients in the Accord'
    type: 'number'
    definition: @aql draft_accords.size ;;
    format: '#,##0'
  }

  metric accord_f_total {
    label: 'Draft Parts of the Accord Ingredients'
    type: 'number'
    hidden: true
    definition: @aql draft_accords.f_parts | exclude_grains(draft_accords.ingredient) ;;
  }

  metric accord_have_share {
    label: 'Share of the Accord the Draft Gives an Ingredient'
    type: 'number'
    hidden: true
    definition: @aql safe_divide(draft_accords.f_parts, accord_f_total) ;;
    format: '#,##0.000'
    description: 'The draft parts of this ingredient over the draft parts of every ingredient of the accord that the draft uses.'
  }

  metric accord_recipe_share {
    label: 'Share of the Accord the Recipe Gives an Ingredient'
    type: 'number'
    hidden: true
    definition: @aql safe_divide(draft_accords.recipe_parts, draft_accords.recipe_total) ;;
    format: '#,##0.000'
    description: 'The recipe parts of this ingredient over all the parts of the recipe.'
  }

  metric accord_row_match {
    label: 'Overlap for One Ingredient'
    type: 'number'
    hidden: true
    definition: @aql case(when: accord_have_share < accord_recipe_share, then: accord_have_share, else: accord_recipe_share) ;;
    format: '#,##0.000'
    description: 'The smaller of what the draft gives the ingredient and what the recipe asks of it.'
  }

  metric accord_pct {
    label: 'How Closely the Draft Matches the Accord (%)'
    type: 'number'
    definition: @aql (unique(draft_accords.ingredient) | select(v: accord_row_match) | sum(v)) * 100 ;;
    format: '#,##0'
    description: '''How well the draft reproduces the accord. Each ingredient of the recipe has a share of the accord, and so does the draft's use of
it. Adding up the smaller of the two for every ingredient gives the match: 100 means the same proportions; an ingredient that is missing, too
little or far too much costs points.'''
  }

  // ---- How long it lasts: the hours until the draft has faded to a fifth of its full strength ----

  metric curve_worn {
    label: 'Still Worn at the Hour'
    type: 'number'
    hidden: true
    definition: @aql case(when: curve_pct >= 20, then: 1, else: 0) ;;
  }

  metric curve_wear_hours {
    label: 'Blend Longevity (h)'
    type: 'number'
    definition: @aql 0.5 * (unique(draft_curve.hour) | select(v: curve_worn) | sum(v)) - 0.5 ;;
    format: '#,##0.0'
    description: 'Longevity: the hours the draft keeps a fifth (20%) or more of its full strength (the projection, at half-hour steps). It keeps fading after that, so it is still faintly there. Illustrative, not measured.'
  }

  // ---- Fixatives: the same, with extra parts of a long-lasting ingredient ----

  metric fix_loud {
    label: 'Loudness with the Extra Parts'
    type: 'number'
    hidden: true
    definition: @aql fixative_options.own_loud + fixative_options.extra_loud ;;
  }

  metric fix_opening {
    label: 'Opening Loudness with the Extra Parts'
    type: 'number'
    hidden: true
    definition: @aql ((fixative_options.own_full + fixative_options.extra_full) | where(fixative_options.hour == 0)) | exclude_grains(fixative_options.hour) ;;
  }

  metric fix_worn {
    label: 'Still Worn at the Hour, with the Extra Parts'
    type: 'number'
    hidden: true
    definition: @aql case(when: safe_divide(fix_loud, fix_opening) >= 0.20, then: 1, else: 0) ;;
  }

  metric fix_wear_hours {
    label: 'Blend Longevity with the Extra Parts (h)'
    type: 'number'
    definition: @aql 0.5 * (unique(fixative_options.hour) | select(v: fix_worn) | sum(v)) - 0.5 ;;
    format: '#,##0.0'
    description: 'The same longevity, for the draft with the added parts of the candidate. Use with the candidate as the dimension.'
  }

  metric fix_hours_gained {
    label: 'Hours Gained by the Extra Parts'
    type: 'number'
    definition: @aql fix_wear_hours - (curve_wear_hours | exclude_grains(fixative_options.candidate, fixative_options.hour, fixative_options.add_parts)) ;;
    format: '#,##0.0'
    description: 'How many more hours of longevity the draft gets from the added parts of the candidate. Use with the candidate as the dimension.'
  }

  metric fix_cost_per_ml {
    label: 'Blend Cost per ml with the Extra Parts (USD)'
    type: 'number'
    hidden: true
    definition: @aql safe_divide((draft_options.parts_cost | exclude_grains(fixative_options.candidate, fixative_options.hour, fixative_options.add_parts)) + fixative_options.cand_cost * fixative_options.add_amount, (draft_parts | exclude_grains(fixative_options.candidate, fixative_options.hour, fixative_options.add_parts)) + fixative_options.add_amount) ;;
  }

  metric fix_cost_delta {
    label: 'What the Extra Parts Add to the Batch (USD)'
    type: 'number'
    definition: @aql (fix_cost_per_ml - (draft_cost_per_ml | exclude_grains(fixative_options.candidate, fixative_options.hour, fixative_options.add_parts))) * settings.blend_ml ;;
    format: '#,##0.00'
    description: 'The batch ingredient cost with the added parts of the candidate, less today. The blend stays the same size, so the other ingredients make room.'
  }

  metric fix_over_ifra {
    label: 'Extra Parts Over Their Safety Limit'
    type: 'number'
    definition: @aql case(when: safe_divide(100 * fixative_options.add_amount, (draft_parts | exclude_grains(fixative_options.candidate, fixative_options.hour, fixative_options.add_parts)) + fixative_options.add_amount) * settings.concentration_avg / 100 > fixative_options.cand_ifra, then: 1, else: 0) ;;
    description: '1 when one more part of a candidate that is not yet in the draft would take more of the finished bottle than its safety limit allows. Use with the candidate as the dimension.'
  }

  // ---- Projection (sillage): how far the formula radiates from the skin ----

  metric draft_projection {
    label: 'Projection'
    type: 'number'
    definition: @aql safe_divide(draft_options.diffusion_impact, draft_options.total_impact) * (0.5 + settings.concentration_avg / 30) ;;
    format: '#,##0.0'
    description: 'How far the formula radiates: the impact-weighted average of how far each ingredient radiates (1 to 10), scaled by concentration (a stronger concentrate projects more). Illustrative, not measured.'
  }

  metric boost_projection {
    label: 'Projection with the Extra Parts'
    type: 'number'
    hidden: true
    definition: @aql safe_divide(boost_options.own_num + boost_options.cand_num, boost_options.own_imp + boost_options.cand_imp) * (0.5 + settings.concentration_avg / 30) ;;
  }

  metric boost_gain {
    label: 'Projection Gained by the Extra Parts'
    type: 'number'
    definition: @aql boost_projection - (draft_projection | exclude_grains(boost_options.candidate, boost_options.add_parts)) ;;
    format: '#,##0.00'
    description: 'How much more the formula radiates with the added parts of the candidate. Use with the candidate as the dimension.'
  }

  metric boost_cost_per_ml {
    label: 'Blend Cost per ml with the Extra Parts (USD)'
    type: 'number'
    hidden: true
    definition: @aql safe_divide((draft_options.parts_cost | exclude_grains(boost_options.candidate, boost_options.add_parts)) + boost_options.cand_cost * boost_options.add_amount, (draft_parts | exclude_grains(boost_options.candidate, boost_options.add_parts)) + boost_options.add_amount) ;;
  }

  metric boost_cost_delta {
    label: 'What the Extra Parts Add to the Batch (USD)'
    type: 'number'
    definition: @aql (boost_cost_per_ml - (draft_cost_per_ml | exclude_grains(boost_options.candidate, boost_options.add_parts))) * settings.blend_ml ;;
    format: '#,##0.00'
    description: 'The batch ingredient cost with the added parts of the candidate, less today. The blend stays the same size, so the other ingredients make room.'
  }

  metric boost_over_ifra {
    label: 'Extra Parts Over Their Safety Limit'
    type: 'number'
    definition: @aql case(when: safe_divide(100 * boost_options.add_amount, (draft_parts | exclude_grains(boost_options.candidate, boost_options.add_parts)) + boost_options.add_amount) * settings.concentration_avg / 100 > boost_options.cand_ifra, then: 1, else: 0) ;;
    description: '1 when one more part of a candidate that is not yet in the draft would take more of the finished bottle than its safety limit allows. Use with the candidate as the dimension.'
  }

}
