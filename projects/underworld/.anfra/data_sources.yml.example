# The data sources this repo's models query, by name: a model's or dataset's
# data_source_name is one of these names. Each connection is passed as-is to
# the database driver: its keys depend on the type.
#
# data_sources.yml holds credentials, so it is git-ignored; this repo commits
# data_sources.yml.example instead, without them. scripts/generate_nether_data.py
# writes the duckdb file this points to.
data_sources:
  nether:
    type: duckdb
    connection:
      # Localise this absolute path after cloning.
      path: /absolute/path/to/anfra-app-examples/projects/underworld/data/nether.duckdb
